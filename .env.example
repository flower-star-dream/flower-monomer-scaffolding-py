# =====================================================================
# flower-monomer-scaffolding 本地敏感配置模板
# @Author: 花海
# @Date: 2026/08/15 15:30
# @Description: 复制本文件为 .env 后填写本地敏感配置（.env 已被 .gitignore 忽略，不会提交仓库）。
#               框架启动时自动加载项目根 .env，application.yml 中 ${ENV} / ${ENV:default} 占位符
#               与环境变量覆盖均可读取此处值；已存在的进程/容器环境变量优先（.env 不覆盖）。
# =====================================================================

# 数据库（application.yml 中 db.mysql.password 使用 ${APP_DB_MYSQL_PASSWORD:} 占位符引用）
APP_DB_MYSQL_PASSWORD=

# 统一鉴权签发密钥（启用 auth 中间件时必填，application.yml app.web.middlewares.auth）
JWT_SECRET_KEY=

# Alembic 迁移数据库 URL（未设置时回落 alembic.ini 的 sqlalchemy.url）
DATABASE_URL=

# AI 模型 API Key（框架 model_config 支持 env:VAR 引用，如 api_key: "env:LLM_API_KEY"）
LLM_API_KEY=
